{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Panel (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/api/Panel.Api/bin/Debug/net9.0/Panel.Api.dll",
      "cwd": "${workspaceFolder}/api/Panel.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "Web: Chrome (requiere npm start)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/web"
    }
  ]
}
